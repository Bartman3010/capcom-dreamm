//
// Super Street Fighter II Turbo
//
desc[gtek-ssf2t]:

name = Super Street Fighter II Turbo
icon = gtek-ssf2t.png
machine = pc
rootpath = C:\GAMETEK\SSF2T
launch = "$(rootpath)\$(EXENAME).EXE" $(ARGS)
osenv = dos
ramkb = 16384
audiohw = sb16
videohw = svga
EXENAME = SF2TURBO
CDLABEL = SF2
//drivetypes = FFH[128M/100M]C

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; optional = true

//
// initialization script
//
script[init]:
    code = [[[$(CRLF)
	        // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
	]]]
	
end

//
//Auto Installer
//
fragment[install-base]:
	rootpath = D:\
	launch = D:\INSTALL.EXE


	//rootpath = C:\
end

game[pc-cd-en]:
	name = English CD
	anchorfile = SF2TURBO.EXE
