desc[cap-ssf2]:

name = Super Street Fighter II: The New Challengers
icon = cap-ssf2.png
machine = pc
rootpath = C:\SSF2
launch = $(rootpath)\$(EXENAME)
osenv = dos
fixdivover = true
mips = $(MIPS_486DX2_50)
ramkb = 16384
audiohw = gmidi+sb16+adlib
videohw = svga
EXENAME = SSF.EXE

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

config[mode]:
    title = Game Mode
    option[game]:  name = Start Game; EXENAME = SSF.EXE
    option[sound]: name = Sound Setup; EXENAME = sound.bat
	
end

//
// English DOS
//
