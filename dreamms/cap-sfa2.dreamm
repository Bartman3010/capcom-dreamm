desc[cap-sfa2]:

name = Street Fighter Alpha 2 / ZERO 2
icon = cap-sfa2.png
machine = pc
osenv = windows 98
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English CD (US)
//
game[pc-cd-en-us]:
    name = English CD (US)
    anchorfile = ALPHA2.exe
    anchordepth = 3
