//
// Resident Evil
//
desc[cap-resevil]:

name = Resident Evil / Biohazard
machine = pc
icon = cap-resevil.png
rootpath = C:\Program Files\RESIDENT EVIL
launch = "D:\$(EXENAME).exe" $(RENDERARG)
osenv = windows 95
filter = nonlucas, action, capcom, horror
winres = 640x480x16
EXENAME = NEWEUR//ResidentEvil
CDLABEL = RESIDENT EVIL
RENDERARG = $(NULL)
//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)\CD; optional = true

//
// Network Mode Toggle
//
config[exetype]:
	condition = file_exists("$$(rootpath)\\NEWEUR.EXE")
	title = Render Mode
	option[ddraw]: name = 3dfx; EXENAME = ResidentEvil; launch = "D:\$(EXENAME).EXE" $(RENDERARG)
	option[d3d]: name = Direct3D; EXENAME = NEWEUR; launch = "$(rootpath)\$(EXENAME).EXE" $(RENDERARG)
end

//
// Network Mode Toggle
//
config[renderarg]:
	title = Render Arguments
	option[null]: name = NULL; RENDERARG = $(NULL)
	option[nocard1]: name = Software Mode A (NoCard1); RENDERARG = /nocard1
	option[nocard2]: name = Software Mode B (NoCard2); RENDERARG = /nocard2
end

//
// initialization script
//
script[cd-init]:
    code = [[[$(CRLF)
        // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
	]]]
end

//
// Checker
//
configutil[]:
    name = Checker
    launch = "D:\Checker.EXE"
end

//
// Launcher
//
configutil[]:
    name = Launcher
    launch = "D:\Launch.EXE"
end

//
// Registry
//
REGISTRY = [[[$(CRLF)
    REGEDIT4
    [HKEY_LOCAL_MACHINE\Software\CAPCOM\RESIDENT EVIL]
    "Install Path"="C:\\Program Files\\"
    "Create Directory"="RESIDENT EVIL"
    "Play Number"=?dword:00000000
    "Clear Number"=?dword:00000000
    "Key Def"=?hex(0):26,28,25,27,00
    "Joy Def"=?hex(0):00,10,00,00,00,40,00,00,00,80,00,00,00,20,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00,00,00,00,00,80,00,00,00,40,00,00,00,08,00,00,00,00,\
      08,00,00,00,09,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00
    "Side Def"=?hex(0):00,10,00,00,00,40,00,00,00,80,00,00,00,20,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00,00,00,00,00,80,00,00,00,40,00,00,00,00,08,00,00,00,\
      09,00,00,00,00,00,00,00,00,00,00,00,00,00,00,08,00,00,00,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,\
      00,00,00,00,00,00,00,00
    "Display Driver"=?dword:00000000
    "Install Flag"=?dword:0000003b
    "X Size"=dword:00000280
    "Y Size"=dword:000001e0
    "Bit Depth"=dword:00000000
    "FullScreen?"=dword:00000001
    "Display Mode"=dword:fffffffb
]]]

script[registry-init]:
	condition = is_windows()
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

