desc[cap-re2]:

name = Resident Evil 2 / Biohazard 2
icon = cap-re2.png
machine = pc
launch = ""
osenv = windows 98
winres = 640x480x16
CDBASED = 1
CLAIRE = 0
LEON = 0

config[discsel]:
    title = Disc Select
    option[leon]: name = Leon; launch = "D:\regist\$(LEONEXE)"; LEON = 1;
    option[claire]: name = Claire; launch = "D:\regist\$(CLAIREEXE)"; CLAIRE = 1;
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)


//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        // disc_insert("2");
        // drive_set_label("D", "$$(CDLABELCLAIRE)");
        // disc_insert("1");
        // drive_set_label("D", "$$(CDLABELLEON)");
    ]]]
end

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English CD US
//
game[pc-cd-en-us]:
    name = English CD US
    anchorfile = LeonU.exe
    anchordepth = 3
    rootpath = C:\Program Files\CAPCOM\RESIDENT EVIL2
    

