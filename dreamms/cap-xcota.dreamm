//
// X-Men: Children of the Atom
// Original file by eientei, CookieMonster123
desc[cap-xcota]:

name = X-Men: Children of the Atom
icon = cap-xcota.png
machine = pc
rootpath = C:\ACCLAIM\XMEN
launch = $(rootpath)\XMENPC.EXE -U
osenv = dos
fixdivover = true
mips = $(MIPS_P100)
ramkb = 16384
audiohw = sb16
videohw = svga
EXENAME = XMENPC
CDLABEL = XMEN_COTA_PC
VERSION = 16MB
//
// filesystem
//
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)/CD; condition = is_game()
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

mount[]: vpath = D:\; srcpath = $(ifsinstallpath)

mount[cdid]: vpath = D:\; srcpath = ram
script[cd-init]:
	code = [[[$(CRLF)
	drive_set_label("D", "$$(CDLABEL)");
	]]]
end


//
// Sound Driver Config
//
CONFIGFILE = [[[$(CRLF)
        DEVICE      Creative Labs Sound Blaster 16 or AWE32
        DRIVER      SB16.DIG
        IO_ADDR     220h
        IRQ         -1
        DMA_8_BIT   -1
        DMA_16_BIT  -1
    ]]]
script[sounddriver-init]:
    code = [[[$(CRLF)
        file_save("$$(rootpath)\\DIG.INI", "$$(CONFIGFILE)");
		
    ]]]
end


