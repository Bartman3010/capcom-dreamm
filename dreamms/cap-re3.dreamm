desc[cap-re3]:

name = Resident Evil 3: NEMESIS / Biohazard 3: LAST ESCAPE
icon = cap-re3.png
machine = pc
osenv = windows 98
winres = 1024x768x16

config[modesel]:
    title = Select Mode
    option[game]: name = Main Game; launch = "$(rootpath)\$(MAINGAME)"; 
    option[merc]: name = Mercenaries; launch = "$(rootpath)\$(MERCENARIES)";
end

//
// filesystem
//
mount[]: vpath = C:\; srcpath = ram; writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English US CD
//
game[pc-cd-en-us]:
