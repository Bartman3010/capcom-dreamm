desc[cap-dino]:

name = Dino Crisis
icon = cap-dino.png
machine = pc
rootpath = C:\Program Files\CAPCOM\DINOCRISIS
launch = "$(rootpath)\launch.exe"
osenv = windows 98
winres = 1024x768x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)


//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
    ]]]
end

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English (US) CD
//
game[pc-cd-en-us]:
    name = English (US) CD
    anchorfile = DINO.EXE
