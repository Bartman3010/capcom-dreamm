desc[hte-sf]:

name = Street Fighter
icon = hte-sf.png
machine = pc
rootpath = C:\SF
launch = $(rootpath)\SF.EXE
osenv = dos
fixdivover = true
mips = $(MIPS_286_10)
ramkb = 512
audiohw = speaker
videohw = ega

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

//
// English DOS
//
game[pc-dos-en]:
    name = English DOS
    anchorfile = SF.EXE
