desc[cap-dino2]:

name = Dino Crisis 2
icon = cap-dino2.png
machine = pc
rootpath = C:\Program Files\CAPCOM\DINO2
launch = "$(rootpath)\Dino2.exe"
osenv = windows 98
winres = 1024x768x16

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)
mount[]: vpath = D:\; srcpath = $(ifsinstallpath)


//
// initialization script
//
script[cd-init]:
	code = [[[$(CRLF)
	    // set the volume label on the CD
        drive_set_label("D", "$$(CDLABEL)");
    ]]]
end

//
// English (US) CD
//
game[pc-cd-en-us]:
    name = English (US) CD
    anchorfile = Dino2.exe
    anchordepth = 3
