desc[cap-sfa]:

name = Street Fighter Alpha / ZERO: Warrior's Dreams
icon = cap-sfa.png
machine = pc
osenv = windows 95
winres = 640x480x8

//
// filesystem
//
mount[]: vpath = C:\; srcpath = $(ifsdeltapath); writable = true
mount[]: vpath = $(rootpath); srcpath = $(ifsinstallpath)

script[registry-init]:
    code = [[[$(CRLF)
        winregistry_import_raw("$$(REGISTRY)");
    ]]]
end

//
// English CD
//
game[pc-cd-en]:
    name = English CD
    anchorfile = ALPHA95.exe
    anchordepth = 3
